# 텔레그램 봇 설정 (@BotFather에서 발급)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance API 키 (자동매매 live 모드 시 필요, paper 모드는 불필요)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here

# FRED API 키 (PPI 데이터 — https://fred.stlouisfed.org/docs/api/api_key.html 에서 무료 발급)
FRED_API_KEY=your_fred_api_key_here

# 매매 모드: paper(모의) | live(실거래)
TRADE_MODE=paper

# 가격 변동 알림 임계값 (0.03 = 3%)
ALERT_THRESHOLD=0.03

# PostgreSQL 연결 (모니터링 봇 상태 저장)
DATABASE_URL=postgresql://xrp_bot:password@localhost:5432/xrp_bot
